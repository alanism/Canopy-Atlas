# Canopy Atlas public environment template

# Optional warehouse settings for external adapters. The local sample fixture
# path works without these values.
GCP_PROJECT_ID=YOUR_PROJECT_ID
BQ_DATASET=YOUR_DATASET
BQ_REGION=US
BQ_MAX_BYTES_BILLED_INCREMENTAL=10000000000
BQ_MAX_BYTES_BILLED_BACKFILL=100000000000

# Generic upstream health API. Leave empty for fixture-only development.
ATLAS_UPSTREAM_API_BASE_URL=
ATLAS_UPSTREAM_ID_TOKEN=

# Private orchestrator trigger. Set locally before calling /internal/run.
ATLAS_ORCHESTRATOR_TOKEN=replace-with-local-random-token

# Chain/token configuration
CHAIN_CONFIG_PATH=config/chains.yaml

# Optional RPC settings for custom validators.
SOLANA_RPC_URL=
ETHEREUM_RPC_URL=

# Cache settings. Empty values use in-memory/local behavior in tests.
REDIS_URL=
REDIS_KEY_PREFIX=canopy_atlas

# Dashboard-to-API proxy. Empty uses the same origin in local Vite/server flows.
CANOPY_DASHBOARD_API_BASE_URL=http://127.0.0.1:8080
CANOPY_BOOTSTRAP_EMPTY_CACHE=1
CANOPY_BOOTSTRAP_PREVIEW_ROWS=1

# Optional paid AgentCash proxy settings. Never commit real values.
CANOPY_BENCHMARK_API_BASE_URL=http://127.0.0.1:8080
AGENTCASH_VERIFIER_URL=
AGENTCASH_VERIFIER_TOKEN=
CHARGE_USDC=0.05
SUPPORTED_PAYMENT_NETWORKS=base,solana
WALLET_RATE_LIMIT_PER_MIN=60
AGENTCASH_MERCHANT_ADDRESS_BASE=
AGENTCASH_MERCHANT_ADDRESS_SOLANA=

# Private paid-agent metrics dashboard.
AGENTCASH_ADMIN_TOKEN=
ADMIN_DASHBOARD_SLUG=agentcash-ops
WALLET_HASH_SALT=
AGENTCASH_METRICS_CACHE_DIR=
